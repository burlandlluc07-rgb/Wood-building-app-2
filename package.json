{
     "name": "nextjs-postgresql-template",
     "version": "1.0.0",
     "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "build:next": "next build --webpack",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "npm run rebuild:native && npm run build:next && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "@electron/rebuild": "^3.7.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.nestforge.app",
    "productName": "NestForge",
    "asar": true,
       "files": [
     "electron/main.js"
    ],
    "extraResources": [
      { "from": ".next", "to": "app/.next", "filter": ["**/*"] },
      { "from": "public", "to": "app/public", "filter": ["**/*"] },
      { "from": "node_modules", "to": "app/node_modules", "filter": ["**/*"] },
      { "from": "package.json", "to": "app/package.json" },
      { "from": "next.config.ts", "to": "app/next.config.ts" },
      { "from": "electron/run-server.js", "to": "app/run-server.js" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true,
    "electron@44.0.0": true
  }
}
